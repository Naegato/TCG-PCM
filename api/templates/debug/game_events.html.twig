{% extends '@WebProfiler/Profiler/layout.html.twig' %}

{% macro render_events_table(events) %}
    <table>
        <thead>
            <tr>
                <th>Id</th>
                <th class="text-right">Type</th>
                <th>Origin</th>
                <th>Line</th>
                <th>Data</th>
                <th>Parent ID</th>
            </tr>
        </thead>

        <tbody>
            {% for event in events %}
                <tr>
                    <td class="text-right nowrap">{{ event.batch }}.{{ event.localId }}</td>
                    <td class="text-right nowrap">{{ event.type.value }}</td>
                    <td class="font-normal">{{ event.eventOrigin }}</td>
                    <td class="font-normal">{{ event.origin ?? 'unknown' }}</td>
                    <td class="font-normal">
                        {% for key, value in event.data %}
                            {% if value is not iterable%}
                                {{ key }} : {{ value }}
                            {% endif %}
                        {% endfor %}
                    </td>
                    <td class="text-right nowrap">{{ event.parentId ? event.batch ~ '.' ~ event.parentId : '' }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endmacro %}

{% macro render_event_node(event, batchEvents) %}
    <li class="event-node">
        <div class="event-node-label{{ event.parentId is null ? ' event-node-root' : '' }}">
            <strong>{{ event.localId }}</strong>
            <span class="font-normal">{{ event.type.value }}</span>
            {% if event.origin %}<span class="event-node-origin">{{ event.origin }}</span>{% endif %}
        </div>
        {% set children = batchEvents|filter(e => e.parentId == event.localId and e.localId != event.localId) %}
        {% if children|length > 0 %}
            <ul>
                {% for child in children %}
                    {{ _self.render_event_node(child, batchEvents) }}
                {% endfor %}
            </ul>
        {% endif %}
    </li>
{% endmacro %}

{% macro render_events_graph(groupedEvents) %}
    <style>
        .event-graph-batch { margin-bottom: 24px; }
        .event-graph-batch h4 { display: flex; align-items: center; gap: 8px; }
        ul.event-graph, ul.event-graph ul { list-style: none; margin: 0; padding-left: 24px; }
        ul.event-graph { padding-left: 0; }
        .event-node { position: relative; padding: 4px 0 4px 16px; border-left: 1px solid var(--border-color, #ccc); }
        .event-node:last-child { border-left-color: transparent; }
        .event-node::before { content: ""; position: absolute; left: 0; top: 16px; width: 12px; border-top: 1px solid var(--border-color, #ccc); }
        .event-node-label { display: inline-flex; align-items: center; gap: 6px; }
        .event-node-root { font-weight: bold; }
        .event-node-origin { color: var(--color-muted, #999); font-size: 0.85em; }
    </style>
    {% for batch, batchEvents in groupedEvents %}
        {% set root = batchEvents|filter(e => e.localId == 1)|first %}
        <div class="event-graph-batch">
            <h4>
                Batch #{{ batch }}
                {% if root %}<span class="font-normal">{{ root.type.value }}</span>{% endif %}
                {% if root and root.isReplayEvent %}<span class="badge status-warning">replayed</span>{% endif %}
            </h4>
            {% if root %}
                <ul class="event-graph">
                    {{ _self.render_event_node(root, batchEvents) }}
                </ul>
            {% else %}
                <p class="font-normal">No root event found for this batch.</p>
            {% endif %}
        </div>
    {% endfor %}
{% endmacro %}

{% macro render_cards_table(cards) %}
    <table>
        <thead>
            <tr>
                <th class="text-right">Id</th>
                <th>Instance id</th>
                <th>Class</th>
                <th>Called methods</th>
                <th>Effects</th>
            </tr>
        </thead>

        <tbody>
            {% for card in cards %}
                <tr>
                    <td class="text-right nowrap">{{ card.id }}</td>
                    <td class="font-normal">{{ card.instanceId }}</td>
                    <td class="font-normal">{{ constant('class', card) }}</td>
                    <td class="font-normal">{{ card.methodCalled|join("\n")|nl2br }}</td>
                    <td class="font-normal">{{ card.effects is defined ? card.effects.all|length : 'unknown' }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endmacro %}

{% macro render_players_table(players, collector) %}
    <table>
        <thead>
            <tr>
                <th class="text-right">Id</th>
                <th>Health point</th>
                <th>Coins</th>
                <th>Hand</th>
                <th>Play area</th>
            </tr>
        </thead>

        <tbody>
            {% for player in players %}
                <tr>
                    <td class="text-right nowrap">{{ player.player.id }}</td>
                    <td class="font-normal">{{ player.healthPoints }}</td>
                    <td class="font-normal">{{ player.coins }}</td>
                    <td class="font-normal">{{ player.hand|join("\n")|nl2br }}</td>
                    <td class="font-normal">{{ profiler_dump(collector.playArea(player.player.id)) }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endmacro %}


{% block menu %}
    <span class="label {{ collector.events ? '' : ' disabled' }} ">
        <span class="icon">{{ include('icons/game.svg') }}</span>
        <strong>Game</strong>
    </span>
{% endblock %}

{% block toolbar %}
    {% set icon %}
        <span class="sf-toolbar-value">Game</span>
    {% endset %}

    {% set text %}
        <div class="sf-toolbar-info-piece">
            <b>Events</b>
            <span>{{ collector.events|length }}</span>
        </div>
    {% endset %}

    {{ include('@WebProfiler/Profiler/toolbar_item.html.twig', { link: false }) }}
{% endblock %}

{% block panel %}
    <h2>Game</h2>

    <div class="metrics">
        <div class="metric-group">
            {% for name, count in collector.eventStats %}
                <div class="metric">
                    <span class="value">{{ count }}</span>
                    <span class="label">{{ name }}</span>
                </div>
            {% endfor %}
        </div>

        <div class="metric-divider"></div>
        <div class="metric-group">
            <div class="metric">
                <span class="value">{{ collector.mainEvent?.type?.value ?? 'Unknow' }}</span>
                <span class="label">Main event</span>
            </div>
            <div class="metric">
                <span class="value">{{ collector.subEvents|length }}</span>
                <span class="label">Sub events</span>
            </div>
        </div>
    </div>

    <div class="sf-tabs">
        {% if collector.eventsCount == 0 %}
            <div class="empty empty-panel">
                <p>No game here.</p>
            </div>
        {% else %}
            <div class="tab">
                <h3 class="tab-title">Events <span class="badge">{{ collector.realEvents|length }}</span></h3>
                <div class="tab-content">
                    {{ _self.render_events_table(collector.realEvents) }}
                </div>
            </div>

            <div class="tab">
                <h3 class="tab-title">Event graph <span class="badge">{{ collector.eventsGroupedByBatch|length }}</span></h3>
                <div class="tab-content">
                    {{ _self.render_events_graph(collector.eventsGroupedByBatch) }}
                </div>
            </div>

            {% if collector.replayedEvents|length != 0 %}
                <div class="tab">
                    <h3 class="tab-title">Replayed event <span class="badge">{{ collector.replayedEvents|length }}</span></h3>
                    <div class="tab-content">
                        {{ _self.render_events_table(collector.replayedEvents) }}
                    </div>
                </div>
            {% endif %}

            <div class="tab">
                <h3 class="tab-title">Game contexts <span class="badge">{{ collector.gameContexts|length }}</span></h3>
                <div class="tab-content">
                    {% for gameContext in collector.gameContexts %}
                         <h4>Game context #{{ loop.index }}</h4>
                         <div>
                             <h5>State</h5>
                             {{ profiler_dump(gameContext.state) }}
                         </div>
                         <div>
                             <h5>Flushed events</h5>
                             {{ profiler_dump(gameContext.flushedEvents) }}
                         </div>
                    {% endfor %}
                </div>
            </div>

            <div class="tab">
                <h3 class="tab-title">Card <span class="badge">{{ collector.cards|length }}</span></h3>
                <div class="tab-content">
                    {{ _self.render_cards_table(collector.cards) }}
                </div>
            </div>

            {% if collector.lastGameState is not null %}
                <div class="tab">
                    <h3 class="tab-title">Last Game State</h3>
                    <div class="tab-content">
                        {{ _self.render_players_table([
                            collector.lastGameState.player1,
                            collector.lastGameState.player2,
                        ], collector) }}
                    </div>
                    <h4>Cards states</h4>
                    {{ profiler_dump(collector.lastCards)}}
                    <h4>Full game state</h4>
                    {{ profiler_dump(collector.fullLastGameState) }}
                </div>
            {% endif %}
        </div>
    {% endif %}
{% endblock %}
