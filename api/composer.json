{
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.5",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "api-platform/doctrine-orm": "^4.3.17",
        "api-platform/symfony": "^4.3.17",
        "doctrine/dbal": "^4.4.4",
        "doctrine/doctrine-bundle": "^3.3.1",
        "doctrine/doctrine-migrations-bundle": "^3.7",
        "doctrine/orm": "^3.6.8",
        "gesdinet/jwt-refresh-token-bundle": "^2.2.2",
        "league/oauth2-google": "^5.0",
        "lexik/jwt-authentication-bundle": "^3.2",
        "nelmio/cors-bundle": "^2.6.1",
        "phpdocumentor/reflection-docblock": "^5.6.7",
        "phpstan/phpdoc-parser": "^2.3.3",
        "symfony/asset": ">=8.1.0",
        "symfony/cache": "8.1.*",
        "symfony/console": ">=8.1.0",
        "symfony/dotenv": ">=8.1.0",
        "symfony/expression-language": ">=8.1.0",
        "symfony/flex": ">=2.11",
        "symfony/framework-bundle": ">=8.1.0",
        "symfony/http-client": "8.1.*",
        "symfony/mailer": "8.1.*",
        "symfony/mercure-bundle": "^0.5.0",
        "symfony/messenger": ">=8.1.0",
        "symfony/monolog-bundle": "^4.0.2",
        "symfony/property-access": ">=8.1.0",
        "symfony/property-info": ">=8.1.0",
        "symfony/rate-limiter": "8.1.*",
        "symfony/runtime": ">=8.1.0",
        "symfony/security-bundle": ">=8.1.0",
        "symfony/serializer": ">=8.1.0",
        "symfony/translation": "8.1.*",
        "symfony/twig-bundle": ">=8.1.0",
        "symfony/validator": ">=8.1.0",
        "symfony/var-exporter": "8.1.*",
        "symfony/yaml": ">=8.1.0",
        "symfonycasts/reset-password-bundle": "^1.25"
    },
    "config": {
        "allow-plugins": {
            "carthage-software/mago": true,
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*",
        "symfony/polyfill-php85": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.1.*"
        }
    },
    "require-dev": {
        "captainhook/captainhook": "^5.29.2",
        "carthage-software/mago": "^1.47.4",
        "doctrine/doctrine-fixtures-bundle": "^4.3.1",
        "phpunit/phpunit": "^12.5.34",
        "symfony/browser-kit": ">=8.1.0",
        "symfony/css-selector": ">=8.1.0",
        "symfony/debug-bundle": "8.1.*",
        "symfony/maker-bundle": ">=1.67.0",
        "symfony/stopwatch": "8.1.*",
        "symfony/web-profiler-bundle": "8.1.*"
    }
}
